# NIDAN AI worker configuration. Copy to ai/.env for local use; never commit .env.
NIDAN_AI_SEED=42
NIDAN_AI_BENCH_VERSION=nidan-bench/0.1
NIDAN_AI_POLICY_VERSION=policy-2026.07
NIDAN_AI_API_BASE_URL=http://127.0.0.1:8000
# Required only for AUTH_MODE=oidc; leave empty for local AUTH_MODE=dev.
NIDAN_AI_AUTH_TOKEN=
NIDAN_AI_AUTH_MODE=dev
NIDAN_AI_REQUEST_TIMEOUT_SECONDS=30
NIDAN_AI_MAX_RETRIES=3
NIDAN_AI_ARTIFACT_DIR=artifacts
NIDAN_AI_REPORT_DIR=reports
# Required only for --source db. The loader issues SELECTs only; never point this at a writer role.
NIDAN_AI_READONLY_DATABASE_URL=

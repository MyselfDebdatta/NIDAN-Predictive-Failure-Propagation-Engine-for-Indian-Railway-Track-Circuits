# NIDAN Backend Environment Configuration
# Copy to .env for local development. Never commit .env with real secrets.

# PostgreSQL 16
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nidan
POSTGRES_USER=nidan
POSTGRES_PASSWORD=nidan_dev_password

# Full connection strings (used by FastAPI / asyncpg & Redis)
DATABASE_URL=postgresql://nidan:nidan_dev_password@localhost:5432/nidan
REDIS_URL=redis://localhost:6379/0

# Application runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Data backend mode: "postgres" (default when DB is up) or "fixture" (in-memory seeded store for offline dev/CI)
NIDAN_DATA_MODE=postgres
# Set to true in production/CI to fail fast if PostgreSQL is unreachable instead of falling back
NIDAN_REQUIRE_POSTGRES=false

# Authentication: "dev" (static seeded operator, no token required) or "oidc" (Keycloak JWKS JWT)
AUTH_MODE=dev
OIDC_ISSUER=
OIDC_AUDIENCE=nidan-api
OIDC_JWKS_URL=

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Advisory metadata
NIDAN_SNAPSHOT_LABEL=14 Jul 2026 · 00:20 IST
NIDAN_POLICY_VERSION=policy-2026.07
